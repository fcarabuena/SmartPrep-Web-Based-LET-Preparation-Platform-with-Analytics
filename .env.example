# Copy to .env for local development. Never commit .env.
# Required in production:
ENV=development
SECRET_KEY=change-me-to-a-long-random-string
# Leave empty locally to use SQLite (smartprep.db). Neon example:
# DATABASE_URL=postgresql://user:password@ep-xxxx.ap-southeast-1.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=

# Public URL used in email links (optional; falls back to the request URL)
BASE_URL=

# Optional: Brevo transactional email (HTTP API; Render free blocks SMTP)
BREVO_API_KEY=
MAIL_FROM=no-reply@example.com
MAIL_FROM_NAME=Smart Prep

# Optional: Google login (OAuth client, redirect URI = <BASE_URL>/auth/google/callback)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional: Google Gemini question generation
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Contact shown in the web scraper's User-Agent (some sites block bots without one)
SCRAPER_CONTACT=fcarabuena793@gmail.com
